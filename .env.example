# Copy to .env.local for local development. Never commit real values.
# On Vercel these are set in Project → Settings → Environment Variables.

# PostgreSQL. Set automatically by the Vercel ↔ Neon integration.
# (POSTGRES_URL is accepted as a fallback for DATABASE_URL.)
DATABASE_URL="postgres://bros:bros_dev_pw@localhost:5433/bros"
# Optional: direct (non-pooled) connection, preferred for migrations.
DATABASE_URL_UNPOOLED=""

# Admin account — created by `npm run db:seed` if it doesn't exist (12+ chars).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-password"
# Set to "true" for one deploy to replace an existing admin's password.
ADMIN_RESET_PASSWORD=""

# Demo catalogue: "true" imports the 12 sample products. Demo stock only if SEED_DEMO_STOCK="true"
# (keep that OFF in production).
SEED_DEMO_CATALOG=""
SEED_DEMO_STOCK=""

# Vercel Blob (product photos). Set automatically when a Blob store is connected.
# Required in production; local dev falls back to public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Razorpay (optional). Online payments stay disabled until all three are set.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: public site URL (defaults to the Vercel production URL).
NEXT_PUBLIC_SITE_URL=""
